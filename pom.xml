<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ahiropg</groupId>
    <artifactId>ahiropg-online</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>ahiropg-online</name>
    <description>Velocity plugin that verifies premium sessions and forwards the correct player UUID to the backend</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ShiroDyeNotFound</id>
            <name>ShiroDyeNotFound</name>
        </developer>
    </developers>

    <properties>
        <!--
            The project version lives here and nowhere else. It becomes:
              - the jar name (ahiropg-online-<revision>.jar)
              - the version inside velocity-plugin.json (filtered at build time)
            The @Plugin annotation in the source cannot be templated, so it is the one
            place still updated by hand; the plugin warns in the log on startup if the
            two ever disagree.
        -->
        <revision>1.0.0</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <velocity.version>3.4.0</velocity.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Velocity itself is provided at runtime; never bundle it into the plugin -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>${velocity.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <resources>
            <!-- Everything else is copied verbatim (config.yml must not be filtered). -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>velocity-plugin.json</exclude>
                </excludes>
            </resource>
            <!-- The plugin descriptor takes its version from the pom, so there is one source of truth. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>velocity-plugin.json</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
